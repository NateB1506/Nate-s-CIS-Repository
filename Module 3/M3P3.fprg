    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="totalAmount" type="Real" array="False" size=""/>
            <declare name="amountPerPerson" type="Real" array="False" size=""/>
            <output expression="&quot;Enter total amount recieved: &quot;" newline="True"/>
            <input variable="totalAmount"/>
            <assign variable="amountPerPerson" expression="totalAmount / 3"/>
            <output expression="&quot;Each person receives: $&quot; &amp; ToFixed(amountPerPerson, 2)" newline="True"/>
        </body>
    </function>
